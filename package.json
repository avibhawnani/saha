{
  "name": "saha",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "scrape:setup": "python3 -m venv scraper/.venv && scraper/.venv/bin/python -m pip install -q -r scraper/requirements.txt",
    "scrape": "cd scraper && ./.venv/bin/python scraper.py",
    "data:mine": "node scripts/mine-descriptions.mjs",
    "data": "node scripts/normalize-events.mjs data/delhi-events-database.json data/mined-events.json data/curated.json && node scripts/geocode.mjs",
    "check:ask": "node scripts/run-ts.mjs scripts/check-ask.ts"
  },
  "dependencies": {
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
